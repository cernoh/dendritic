__pycache__/
.planning/
/.worktrees/
*.core
node_modules/
# Pi harness runtime: background-task logs and captured output, at the repo
# root or nested under a feature (e.g. modules/features/mango/.pi/). Unanchored
# so every level is covered. Agent config that is worth carrying between
# machines lives in modules/features/<agent>/home/agent/ instead
# (settings.json, open-tui.json, npm/package.json, skills/, managed-skills/).
.pi/
# pi-coding-agent runtime (tracked config is modules/features/pi-coding-agent/home/agent/)
# declarative files there are settings.json, open-tui.json, npm/package.json, skills/ symlinks
# Regenerated at runtime and multi-megabyte: the pi-sessions SQLite index (25 MB
# once committed a binary diff into unrelated commits), the jiti transpile cache,
# and the tool-call audit log.
modules/features/pi-coding-agent/home/agent/cache/
modules/features/pi-coding-agent/home/agent/pi-sessions/index.sqlite
modules/features/pi-coding-agent/home/agent/pi-sessions/index.sqlite.lock.sqlite
modules/features/pi-coding-agent/home/agent/toolcall-audit.jsonl
