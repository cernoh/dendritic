# Runtime state — not tracked, survives via out-of-store symlink but not committed
auth.json
models-store.json
sessions/
fff/
memory/
web-search-cache/
# Holds a LIVE relay credential: `relays[].auth` is a 256-bit token the freeflow
# provider sends to the relay worker. Runtime state like auth.json, so it must
# never be `git add`ed — see home/agent/AGENTS.md.
pi-freeflow-relay-state.json
# Written on every switch by home.activation.piTheme from features/scheme.
themes/
# `*.log*`, not `*.log`: a rotated log is `….log.1`, which `*.log` never matched,
# so a 67k-line log was tracked. Same reason broker.pid is listed here.
*.log*
*.pid
pi-freeflow-upstream-health.json
