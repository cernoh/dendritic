# Runtime state under this tree. `~/.omp` is an out-of-store symlink to it, so
# everything the agent writes at runtime lands here. None of it is config.
#
# Tracked on purpose: agent/agents/, agent/managed-skills/, agent/extensions/,
# agent/scripts/, agent/skills/, agent/prompts/, agent/plugins/,
# agent/settings.json and agent/memories/.

# Browser profile snapshot: component caches, Safe Browsing stores, adblock
# engine caches, LevelDB LOCK/MANIFEST files, BrowserMetrics blobs. 130 MB that
# no module references. The browser regenerates all of it, and every browser run
# dirtied the working tree, which also invalidates the flake eval cache on the
# next nix command. A deliberately seeded profile belongs in a module.
browser-profiles/

# Agent session transcripts, model caches, uploaded blobs, hook scratch.
agent/sessions/
agent/cache/
agent/blobs/
agent/custom-session-files/
agent/terminal-sessions/
agent/last-changelog-version

# SQLite state and its sidecars.
*.db
*.db-shm
*.db-wal

# Written by the module activation on every switch (ompConfig, ompTheme,
# ompHtmlTheme), so committing them only creates churn.
agent/mcp.json
agent/themes/
agent/html-theme.json

# Session report exports.
agent/html/

# Downloaded toolchains and process scratch: Chrome for Testing, native
# addons, pid and socket files, agent logs, ssh control sockets, worktrees.
puppeteer/
natives/
run/
wt/
logs/
cache/
ssh-control/
install-id
gpu_cache.json
