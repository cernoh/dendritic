# Ghostty Terminal Configuration

# Font settings
font-family = "DroidSansM Nerd Font Mono"
font-size = 14

# Window settings
window-padding-x = 10
window-padding-y = 10
window-theme = "dark"
macos-option-as-alt = true
background-opacity = 0.85
background-blur = true

# Color scheme — built-in Catppuccin Mocha. Matches the flake-wide default
# (self.catppuccin.default, modules/features/catppuccin); this static file
# cannot read nix values, so keep the names in sync manually.
theme = Catppuccin Mocha

# Terminal features
cursor-style = block

# Key bindings
